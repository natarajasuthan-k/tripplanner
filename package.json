{
  "name": "tripplanner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tripplanner/api --filter @tripplanner/web dev",
    "dev:api": "pnpm --filter @tripplanner/api dev",
    "dev:web": "pnpm --filter @tripplanner/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @tripplanner/api db:generate",
    "db:migrate": "pnpm --filter @tripplanner/api db:migrate",
    "db:seed": "pnpm --filter @tripplanner/api db:seed",
    "test:e2e": "pnpm --filter @tripplanner/e2e test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
