// Cloudflare Workers config — backend-spec §1, §8, §10, §12.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tripplanner-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Hourly cleanup of stale presence, rate counters and provider cache (backend §10).
  "triggers": { "crons": ["0 * * * *"] },

  // Per-IP, per-minute limits (backend §8). Hourly limits (create trip, recover) use the
  // rate_counters table because the binding only supports 10s/60s periods.
  "ratelimits": [
    { "name": "RL_READ", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_PRESENCE", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_SEARCH", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
  ],

  // Non-secret config. Secrets (DATABASE_URL, GEOAPIFY_API_KEY, RESEND_API_KEY,
  // EMAIL_HMAC_SECRET) are set with `wrangler secret put` or in .dev.vars locally.
  "vars": {
    "APP_PUBLIC_URL": "http://localhost:5173",
    "CORS_ORIGIN": "http://localhost:5173",
    "EMAIL_FROM": "Trip Planner <onboarding@resend.dev>",
    "LOG_LEVEL": "debug",
    // "fake" = built-in fixture destinations (no API key needed). Production must use "live".
    "PROVIDER_MODE": "fake",
    // "log" = don't send emails, just log a redacted line. Production must use "live".
    "EMAIL_MODE": "log",
  },
}
