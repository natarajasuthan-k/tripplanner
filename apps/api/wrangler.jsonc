// Cloudflare Workers config — backend-spec §1, §8, §9, §10, §12.
// Top level = local development (`wrangler dev`). `env.production` = the deployed Worker
// (`wrangler deploy --env production`). Vars and bindings are NOT inherited by environments,
// so they are repeated below.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tripplanner-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Hourly cleanup of stale presence, rate counters and provider cache (backend §10).
  "triggers": { "crons": ["0 * * * *"] },

  // Per-IP, per-minute limits (backend §8). Hourly limits (create trip, recover) use the
  // rate_counters table because the binding only supports 10s/60s periods.
  "ratelimits": [
    { "name": "RL_READ", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_PRESENCE", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_SEARCH", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
  ],

  // Non-secret config. Secrets (DATABASE_URL, GEOAPIFY_API_KEY, RESEND_API_KEY,
  // EMAIL_HMAC_SECRET) come from .dev.vars locally and `wrangler secret put --env production`.
  "vars": {
    "ENVIRONMENT": "development",
    "APP_PUBLIC_URL": "http://localhost:5173",
    "CORS_ORIGIN": "http://localhost:5173",
    "EMAIL_FROM": "Trip Planner <onboarding@resend.dev>",
    "LOG_LEVEL": "debug",
    // "fake" = built-in fixture destinations and places (no API key needed).
    "PROVIDER_MODE": "fake",
    // "log" = don't send emails, just log a redacted line.
    "EMAIL_MODE": "log",
  },

  "env": {
    "production": {
      "name": "tripplanner-api",
      "workers_dev": true,
      "triggers": { "crons": ["0 * * * *"] },
      "ratelimits": [
        { "name": "RL_READ", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } },
        { "name": "RL_WRITE", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_PRESENCE", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_SEARCH", "namespace_id": "2004", "simple": { "limit": 60, "period": 60 } },
      ],
      // The web app's address (docs/deployment.md, step 4). No trailing slash.
      "vars": {
        "ENVIRONMENT": "production",
        "APP_PUBLIC_URL": "https://tripplanner.natarajasuthan.workers.dev",
        "CORS_ORIGIN": "https://tripplanner.natarajasuthan.workers.dev",
        // TODO before inviting pilot users: switch to an address on your Resend-verified domain.
        // onboarding@resend.dev only delivers to the Resend account owner (docs/deployment.md, step 3).
        "EMAIL_FROM": "Trip Planner <onboarding@resend.dev>",
        "LOG_LEVEL": "info",
        "PROVIDER_MODE": "live",
        "EMAIL_MODE": "live",
      },
    },
  },
}
