// The web app is served by a Cloudflare Worker with static assets (frontend-spec §1, Q-F10).
// Build first (`pnpm build`), then `wrangler deploy`. `dist/_headers` (CSP etc.) is generated by
// tooling/securityHeaders.ts and applied by Cloudflare to every asset response.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tripplanner",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Client-side routes (/o/…, /explore/…) fall back to index.html.
    "not_found_handling": "single-page-application",
  },
}
